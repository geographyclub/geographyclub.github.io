{
	"version": 8,
	"name": "versatiles-colorful",
	"metadata": {
		"maputnik:renderer": "mbgljs",
		"license": "https://creativecommons.org/publicdomain/zero/1.0/"
	},
	"glyphs": "https://geographyclub.github.io/toronto-map/assets/fonts/{fontstack}/{range}.pbf",
	"sprite": "https://geographyclub.github.io/toronto-map/assets/sprites/sprites-maki",
	"sources": {
		"osm": {
			"type": "vector",
			"url": "https://vector.openstreetmap.org/shortbread_v1/tilejson.json"
		}
	},
	"layers": [
		{
			"id": "background",
			"type": "background",
			"paint": {
				"background-color": "#F4F6F8"
			}
		},
		{
			"source": "osm",
			"id": "water-ocean",
			"type": "fill",
			"source-layer": "ocean",
			"paint": {
				"fill-color": "#beddf3"
			}
		},
		{
			"source": "osm",
			"id": "water-line",
			"type": "line",
			"source-layer": "water_lines",
			"paint": {
				"line-color": "#beddf3",
				"line-width": { "stops": [ [ 9, 0 ], [ 10, 3 ], [ 15, 5 ], [ 17, 9 ], [ 18, 20 ], [ 20, 60 ] ] }
			},
			"layout": {
				"line-cap": "round",
				"line-join": "round"
			}
		},
		{
			"source": "osm",
			"id": "water-area",
			"type": "fill",
			"source-layer": "water_polygons",
			"paint": {
				"fill-color": "#beddf3",
				"fill-opacity": { "stops": [ [ 4, 0 ], [ 6, 1 ] ] }
			}
		},
		{
			"source": "osm",
			"id": "building:outline",
			"type": "line",
			"source-layer": "buildings",
			"paint": {
				"line-color": "#B0B0B0",
				"line-width": 0.6,
				"line-opacity": { "stops": [ [ 14, 0 ], [ 15, 1 ] ] }
			}
		},
		{
			"source": "osm",
			"id": "street-minor",
			"type": "line",
			"source-layer": "streets",
			"filter": [ "in", "kind", "residential", "tertiary", "secondary" ],
			"paint": {
				"line-color": "#B0B0B0",
				"line-width": 1,
				"line-opacity": { "stops": [ [ 12, 0 ], [ 13, 1 ] ] }
			},
			"layout": {
				"line-join": "round",
				"line-cap": "round"
			}
		},		
		{
			"source": "osm",
			"id": "street-major",
			"type": "line",
			"source-layer": "streets",
			"filter": [ "in", "kind", "trunk", "motorway", "primary" ],
			"paint": {
				"line-color": "#B0B0B0",
				"line-width": 1,
				"line-opacity": { "stops": [ [ 12, 0 ], [ 13, 1 ] ] }
			},
			"layout": {
				"line-join": "round",
				"line-cap": "round"
			}
		},
		{
			"source": "osm",
			"id": "poi",
			"type": "symbol",
			"source-layer": "pois",
			"filter": ["has", "name"],
			"layout": {
				"text-field": ["get", "name"],
				"text-font": ["montserrat-regular"],
				"text-transform": "uppercase",
				"text-size": 6,
				"text-max-width": 10,
				"text-line-height": 1.1
			},
			"paint": {
				"text-color": "#333344",
				"text-halo-color": "#F4F6F8",
				"text-halo-width": 2,
				"text-halo-blur": 1
			}
		},
		{
			"source": "osm",
			"id": "label-street-minor",
			"type": "symbol",
			"source-layer": "street_labels",
			"filter": [ "in", "kind", "secondary", "tertiary", "residential" ],
			"layout": {
				"text-field": "{name}",
				"text-font": [ "montserrat-semibold" ],
				"symbol-placement": "line",
				"text-anchor": "bottom",
				"text-transform": "uppercase",
				"text-letter-spacing": 0.2,
				"text-size": 6
			},
			"paint": {
				"text-color": "#333344",
				"text-halo-color": "#F4F6F8",
				"text-halo-width": 2,
				"text-halo-blur": 1
			}
		},
		{
			"source": "osm",
			"id": "label-street-major",
			"type": "symbol",
			"source-layer": "street_labels",
			"filter": [ "in", "kind", "motorway", "trunk", "primary" ],
			"layout": {
				"text-field": "{name}",
				"text-font": [ "montserrat-semibold" ],
				"symbol-placement": "line",
				"text-anchor": "bottom",
				"text-transform": "uppercase",
				"text-letter-spacing": 0.2,
				"text-size": 6
			},
			"paint": {
				"text-color": "#333344",
				"text-halo-color": "#F4F6F8",
				"text-halo-width": 2,
				"text-halo-blur": 1
			}
		}		
	]
}
