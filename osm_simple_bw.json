{
	"version": 8,
	"name": "versatiles-colorful",
	"metadata": {
		"maputnik:renderer": "mbgljs",
		"license": "https://creativecommons.org/publicdomain/zero/1.0/"
	},
	"glyphs": "https://geographyclub.github.io/toronto-map/assets/fonts/{fontstack}/{range}.pbf",
	"sprite": "https://geographyclub.github.io/toronto-map/assets/sprites/sprites-maki",
	"sources": {
		"osm": {
			"type": "vector",
			"url": "https://vector.openstreetmap.org/shortbread_v1/tilejson.json"
		}
	},
	"layers": [
		{
			"id": "background",
			"type": "background",
			"paint": {
				"background-color": "#fff"
			}
		},
		{
			"source": "osm",
			"id": "water-ocean",
			"type": "fill",
			"source-layer": "ocean",
			"paint": {
				"fill-color": "#eee"
			}
		},
		{
			"source": "osm",
			"id": "water-river",
			"type": "line",
			"source-layer": "water_lines",
			"paint": {
				"line-color": "#eee",
				"line-width": { "stops": [ [ 9, 0 ], [ 10, 3 ], [ 15, 5 ], [ 17, 9 ], [ 18, 20 ], [ 20, 60 ] ] }
			},
			"layout": {
				"line-cap": "round",
				"line-join": "round"
			}
		},
		{
			"source": "osm",
			"id": "water-area",
			"type": "fill",
			"source-layer": "water_polygons",
			"filter": [ "==", "kind", "water" ],
			"paint": {
				"fill-color": "#eee",
				"fill-opacity": { "stops": [ [ 4, 0 ], [ 6, 1 ] ] }
			}
		},
		{
			"source": "osm",
			"id": "street:outline",
			"type": "line",
			"source-layer": "streets",
			"filter": [ "in", "kind", "motorway", "trunk", "primary", "secondary", "tertiary" ],
			"paint": {
				"line-color": "#222",
				"line-width": { "stops": [ [ 8, 0 ], [ 9, 1 ], [ 10, 4 ], [ 14, 6 ], [ 16, 12 ], [ 18, 36 ], [ 19, 74 ], [ 20, 144 ] ] }
			},
			"layout": {
				"line-join": "round",
				"line-cap": "round"
		}
		},			
		{
			"source": "osm",
			"id": "street",
			"type": "line",
			"source-layer": "streets",
			"filter": [ "in", "kind", "motorway", "trunk", "primary", "secondary", "tertiary" ],
			"paint": {
				"line-color": "#333",
				"line-width": { "stops": [ [ 5, 0 ], [ 6, 1 ], [ 10, 4 ], [ 14, 4 ], [ 16, 12 ], [ 18, 36 ], [ 19, 80 ], [ 20, 160 ] ] },
				"line-opacity": { "stops": [ [ 5, 0 ], [ 6, 1 ] ] }
			},
			"layout": {
				"line-join": "round",
				"line-cap": "round"
			}
		},
		{
			"source": "osm",
			"id": "highway-name",
			"type": "symbol",
			"source-layer": "street_labels",
			"filter": [ "in", "kind", "motorway", "trunk", "primary", "secondary", "tertiary" ],
			"layout": {
				"text-field": "{name}",
				"text-transform": "uppercase",
				"text-rotation-alignment": "map",
				"text-font": [ "notosans" ],
				"text-letter-spacing": 0.2,
				"text-allow-overlap": false,
				"text-ignore-placement": false,
				"symbol-placement": "line",
				"text-anchor": "center",
				"text-size": [ "interpolate", [ "linear" ], [ "zoom" ], 10, 0, 20, 20 ],
				"symbol-sort-key": 100
			},
			"paint": {
				"text-color": "#fff",
				"text-opacity": [ "interpolate", [ "linear" ], [ "zoom" ], 10, 0, 11, 1 ]
			}
		}		
	]
}
