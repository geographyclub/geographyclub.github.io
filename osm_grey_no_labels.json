{
	"version": 8,
	"name": "versatiles-colorful",
	"metadata": {
		"maputnik:renderer": "mbgljs",
		"license": "https://creativecommons.org/publicdomain/zero/1.0/"
	},
	"glyphs": "https://geographyclub.github.io/toronto-map/assets/fonts/{fontstack}/{range}.pbf",
	"sprite": "https://geographyclub.github.io/toronto-map/assets/sprites/sprites-maki",
	"sources": {
		"osm": {
			"type": "vector",
			"url": "https://vector.openstreetmap.org/shortbread_v1/tilejson.json"
		}
	},
	"layers": [
		{
			"id": "background",
			"type": "background",
			"paint": {
				"background-color": "hsl(0, 0%, 95%)"
			}
		},
		{
			"source": "osm",
			"id": "water-ocean",
			"type": "fill",
			"source-layer": "ocean",
			"paint": {
				"fill-color": "hsl(0, 0%, 90%)"
			}
		},
		{
			"source": "osm",
			"id": "water-river",
			"type": "line",
			"source-layer": "water_lines",
			"paint": {
				"line-color": "hsl(0, 0%, 90%)",
				"line-width": { "stops": [ [ 9, 0 ], [ 10, 3 ], [ 15, 5 ], [ 17, 9 ], [ 18, 20 ], [ 20, 60 ] ] }
			},
			"layout": {
				"line-cap": "round",
				"line-join": "round"
			}
		},
		{
			"source": "osm",
			"id": "water-area",
			"type": "fill",
			"source-layer": "water_polygons",
			"paint": {
				"fill-color": "hsl(0, 0%, 90%)",
				"fill-opacity": { "stops": [ [ 4, 0 ], [ 6, 1 ] ] }
			}
		},
		{
			"source": "osm",
			"id": "street-residential",
			"type": "line",
			"source-layer": "streets",
			"filter": [ "==", "kind", "residential" ],
			"paint": {
				"line-color": "hsl(0, 0%, 100%)",
				"line-width": { "stops": [ [ 12, 1 ], [ 14, 2 ], [ 16, 5 ], [ 18, 24 ], [ 19, 60 ], [ 20, 120 ] ] },
				"line-opacity": { "stops": [ [ 14.5, 0 ], [ 15, 1 ] ] }
			},
			"layout": {
				"line-join": "round",
				"line-cap": "round"
			}
		},					
		{
			"source": "osm",
			"id": "street",
			"type": "line",
			"source-layer": "streets",
			"filter": [ "in", "kind", "motorway", "trunk", "primary", "secondary", "tertiary" ],
			"paint": {
				"line-color": "hsl(0, 0%, 100%)",
				"line-width": { "stops": [ [ 8, 0 ], [ 9, 2 ], [ 10, 3 ], [ 14, 5 ], [ 16, 10 ], [ 18, 34 ], [ 19, 70 ], [ 20, 140 ] ] },
				"line-opacity": { "stops": [ [ 5, 0 ], [ 6, 1 ] ] }
			},
			"layout": {
				"line-join": "round",
				"line-cap": "round"
			}
		}
	]
}
